# Rust build artifacts
/target/
**/target/
/.artifacts/

# Backtrace/profiling output
*.profraw

# Spike scratch — run logs, pids, and anything an agent leaves behind
*.log
*.pid
/.proof/
/.gui-run.json

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Secrets — never commit signing keys or store credentials
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision

# Competitor UI reference lives outside the repository by design (D17).
# This entry exists so an accidental copy is never committed.
/reference/

# Packaged artifacts. tools/package.sh and .github/workflows/release.yml both
# assemble here; the results are large, per-commit, and reproducible from the
# scripts, so they belong in CI artifacts rather than in history.
/dist/
Scrozz.app/
